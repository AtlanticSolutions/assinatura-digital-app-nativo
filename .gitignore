target/
**/target/
build/
**/build/
out/
**/out/
*.class
**/*.class
*.jar
**/*.jar
*.war
**/*.war
*.ear
**/*.ear
*.zip
**/*.zip
*.tar.gz
*.tgz

# --- Certificates & Keys (Sensitive Data) ---
*.pfx
*.p12
*.pem
*.key
*.crt
*.der
*.jks
