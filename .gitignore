!app-nativo/src/main/resources/certs/   # Permitir apenas se houver uma pasta de templates seguros (não é o caso hoje)

# --- Logs ---
*.log
**/log/
**/*.log

# --- Demo & Test Outputs ---
web-demo/*.pdf
web-demo-remote/*.pdf
**/*.pdf
!docs/**/*.pdf   # Permitir PDFs de documentação oficial, se houver

